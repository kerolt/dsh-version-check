{
  "name": "dsh-version-check",
  "version": "0.2.1",
  "description": "在 DSH Web 侧边栏底部显示 DSH 版本，从 npm 检查新版本，并支持一键更新与自动重启服务；更新检查可在设置页里开关与调整。",
  "type": "module",
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": "./lib/client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "version-check"
  ],
  "scripts": {
    "build": "tsdown",
    "check": "tsc -p tsconfig.json",
    "prepack": "npm run build",
    "pretest": "npm run build",
    "test": "node --test test/*.test.ts",
    "verify": "npm run build && npm run check && node --test test/*.test.ts"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    }
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "~4.0.5",
    "@deepseek-ai/dsh-host-webserver": "^0.2.1-rc.3",
    "@types/node": "^24.19.2",
    "tsdown": "^0.23.4",
    "typescript": "^5.9.3"
  }
}
